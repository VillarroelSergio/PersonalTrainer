{
  "name": "trainer",
  "private": true,
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev apps/web --turbo",
    "build": "next build apps/web",
    "start": "next start apps/web",
    "lint": "eslint --config apps/web/eslint.config.mjs apps/web",
    "typecheck": "tsc --noEmit --incremental false -p apps/web/tsconfig.json",
    "test": "vitest run --config apps/web/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config apps/web/vitest.config.ts",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "db:generate": "drizzle-kit generate --config apps/web/drizzle.config.ts",
    "db:migrate": "tsx --tsconfig apps/web/tsconfig.json apps/web/drizzle/migrate.ts",
    "db:seed": "tsx --tsconfig apps/web/tsconfig.json apps/web/drizzle/seed.ts",
    "user:create": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/manage-user.ts create",
    "user:reset-password": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/manage-user.ts reset-password",
    "backup:production": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/backup-production.ts"
  },
  "dependencies": {
    "@garmin/fitsdk": "^21.212.0",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/speed-insights": "^1.2.0",
    "better-auth": "^1.3.0",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.10.1",
    "next": "^15.2.0",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^3.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.20.0",
    "eslint-config-next": "^15.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
